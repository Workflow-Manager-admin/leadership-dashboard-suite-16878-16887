# Environment configuration for dashboard_frontend (React)
# Copy this file to '.env' in this same folder. Do NOT commit your actual .env file with secrets.

# The backend API endpoint for the React app to use. Required for API calls.
REACT_APP_API_URL=http://localhost:3001

# CAUTION: Only set this to 'true' if you need to disable host checking (dev environments with non-localhost URLs, like codespaces).
REACT_APP_DANGEROUSLY_DISABLE_HOST_CHECK=false
