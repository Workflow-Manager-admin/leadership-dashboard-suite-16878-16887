# Example environment variables for dashboard_frontend (React)
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT .env (it may contain secrets or deployment settings)

# Backend API base URL (required for normal function)
REACT_APP_API_URL=http://localhost:3001

# OPTIONAL: Dangerous override for Webpack Dev Server host check (rarely needed, see below)
REACT_APP_DANGEROUSLY_DISABLE_HOST_CHECK=false

# CRUCIAL FOR CLOUD/CONTAINER/PREVIEW (fixes 'Invalid Host header' error)
# Set this for remote access, preview, or cloud container environments:
HOST=0.0.0.0

# Optional: override dev server port (leave commented to default to 3000)
# PORT=3000

# (Optional) Set to false to disable launching browser on npm start in cloud builds
# BROWSER=none

# (Advanced) If using a custom domain or reverse proxy, set public URL here
# PUBLIC_URL=http://your.preview.env/  # e.g. https://<your-app>.kavia.ai/

##############################################
# Notes and Troubleshooting:
# - Most "Invalid Host header" errors in preview/cloud are due to not setting HOST=0.0.0.0
# - Restart the dev server after changing .env.
# - If running on a cloud/CI/preview platform, verify that platform does not override or filter out .env settings.
# - If the error still occurs:
#    1. Ensure your .env is at the project root and named exactly ".env"
#    2. Check that npm scripts in package.json do not hardcode HOST or PORT
#    3. Confirm you did NOT place .env in /src or any subfolder
#    4. You may need to clear or "Reset Environment" in your preview tool to reload .env
#    5. Only set REACT_APP_DANGEROUSLY_DISABLE_HOST_CHECK to "true" in extreme cases; prefer HOST
#    6. For ejected/custom servers, check their docs for host header instructions.

# For more, see:
# - https://create-react-app.dev/docs/advanced-configuration/
# - https://github.com/facebook/create-react-app/issues/11203
# - https://github.com/facebook/create-react-app/issues/6560
