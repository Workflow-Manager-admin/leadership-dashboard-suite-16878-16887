# API config for dashboard frontend
# Copy to ".env" and edit as needed.

# Backend server base URL, e.g. "http://localhost:3001" for local dev,
# or full production backend URL when deploying.
REACT_APP_API_URL=http://localhost:3001

# NOTE:
# - For local dev, you can *alternatively* add this line to package.json:
#   "proxy": "http://localhost:3001"
# - If both are present, .env will take priority.
